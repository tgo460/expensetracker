# Streamlit Secrets Configuration Example
# Copy this file to secrets.toml in the same folder (.streamlit/secrets.toml)
# Or paste these variables in Streamlit Cloud Dashboard -> Settings -> Secrets

# 1. Google Gemini API Key (Get free from: https://aistudio.google.com/)
GEMINI_API_KEY = "your_actual_gemini_api_key_here"

# 2. (Optional) Preferred Currency Symbol (Defaults to ₹)
CURRENCY = "₹"

# 3. (Optional) Google Sheets Database Integration
# If using st-gsheets-connection, provide your public/service account credentials:
# [connections.gsheets]
# spreadsheet = "https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID_HERE"
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "..."
# client_email = "..."
# client_id = "..."

